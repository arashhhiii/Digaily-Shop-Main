<!DOCTYPE html>
<html dir="ltr" lang="en">
<head>
    <partial name="_AdminMetaTages" />
    <partial name="_AdminHeaderRefrences" />
</head>
<body>
    <div class="preloader">
        <div class="lds-ripple">
            <div class="lds-pos"></div>
            <div class="lds-pos"></div>
        </div>
    </div>
    <div id="main-wrapper">
        <header class="topbar">
            <nav class="navbar top-navbar navbar-expand-md navbar-dark">
                <div class="navbar-header">
                    <a class="nav-toggler waves-effect waves-light d-block d-md-none" href="javascript:void(0)" aria-label="Toggle navigation">
                        <i class="ti-menu ti-close"></i>
                    </a>
                    <div class="navbar-brand">
                        <a class="logo" asp-area="Admin" asp-controller="Product" asp-action="FilterProduct">
                            <span class="logo-text text-white">Digaily Shop</span>
                        </a>
                        <a class="sidebartoggler d-none d-md-block" href="javascript:void(0)" data-sidebartype="mini-sidebar" aria-label="Toggle sidebar">
                            <i class="mdi mdi-toggle-switch mdi-toggle-switch-off font-20"></i>
                        </a>
                    </div>
                    <a class="topbartoggler d-block d-md-none waves-effect waves-light" href="javascript:void(0)" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle top navigation">
                        <i class="ti-more"></i>
                    </a>
                </div>
                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav float-left mr-auto">
                        <li class="nav-item d-none d-md-block">
                            <span class="nav-link">Administration</span>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>
        <partial name="_AdminMobileMenu" />
        <div class="page-wrapper">
            <div class="container-fluid">
                <partial name="_AdminMessage" />
                @RenderBody()
            </div>
            <footer class="footer text-center">
                &copy; @DateTime.Now.Year Digaily Shop
            </footer>
        </div>
    </div>
    <partial name="_AdminFooterRef" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>