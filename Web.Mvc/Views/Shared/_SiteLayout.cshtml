<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">

    <link rel="stylesheet" href="~/Site/home.css" />
    <partial name="_SiteMetaTages" />
    <partial name="_SiteHeaderRefrences" />
    @RenderSection("SiteHeaderSection", false);
    <title>@ViewData["Title"]</title>
    <style>

    </style>
</head>
<body>
    @await Component.InvokeAsync("SiteHeader")
    @RenderBody()
    <partial name="~/Views/Shared/Copmponent/SiteProductPage/ProductPage.cshtml" />
    <partial name="~/Views/Shared/Copmponent/SiteCheckoutPage/CheckoutPage.cshtml" />
    <partial name="~/Views/Shared/Copmponent/SiteConfirmationPage'/ConfirmationPage.cshtml" />
    @await Component.InvokeAsync("SiteFooter")
    @await Component.InvokeAsync("HomeCartViewer")

    <partial name="_SiteAccountCenter" />
        <partial name="_SiteCartView" />
        <partial name="_SiteDockMenu" />
        <partial name="_SiteFooterRef" />
    @RenderSection("SiteFooterSection", false);
        @if (ViewData["AccountCenterUser"] is string accountCenterUser)
        {
            <script>
                try { localStorage.setItem('digaily-user', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(accountCenterUser))); } catch (e) { }
                window.location.replace('/#/account');
            </script>
        }
        <script src="~/Site/locale.js" defer></script>
        <script src="~/Site/home.js" defer></script>
        <script>
        </script>
    </body>
</html>
