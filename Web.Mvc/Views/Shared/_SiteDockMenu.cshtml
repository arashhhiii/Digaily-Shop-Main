<div class="dock-wrap" id="dockWrap">
    <section class="glass dk-panel" id="dkPanel" role="dialog" aria-live="polite" aria-labelledby="dkTitle" hidden></section>
    <nav class="glass dock" id="dock" aria-label="Support, account and about">
        <button class="dk-trig" id="dkTrig" type="button" aria-label="Open support, sign in and about" aria-expanded="false"><span data-icon="dots" data-size="22" data-sw="0"></span></button>
        <div class="dk-items" id="dkItems">
            <span class="dk-pill" id="dkPill" aria-hidden="true"></span>
            <button class="dk" type="button" data-dk="support" aria-expanded="false" aria-controls="dkPanel"><span data-icon="headset" data-size="20" data-sw="1.9"></span><span class="lbl">Support</span></button>
            <button class="dk" type="button" data-dk="signin" aria-expanded="false" aria-controls="dkPanel"><span data-icon="user" data-size="20" data-sw="1.9"></span><span class="lbl" id="dkSignLbl">Sign in</span></button>
            <button class="dk" type="button" data-dk="about" aria-expanded="false" aria-controls="dkPanel"><span data-icon="info" data-size="20" data-sw="1.9"></span><span class="lbl">About</span></button>
        </div>
    </nav>
</div>
<div class="sr" aria-live="polite" id="live"></div>
