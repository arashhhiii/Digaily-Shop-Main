@if (
    TempData["SuccessMessage"] != null ||
    TempData["ErrorMessage"] != null ||
    TempData["InfoMessage"] != null ||
    TempData["WarningMessage"] != null
)
{
    if (TempData["SuccessMessage"] != null)
    {
        <script>
            $(document).ready(function() {
                ShowMessage("successs message", 'TempData["SuccessMessage"]', 'success');
                        });
        </script>
    }
    if (TempData["ErrorMessage"] != null)
    {
        <script>
            $(document).ready(function() {
                ShowMessage("error message", 'TempData["ErrorMessage"]', 'error');
                        });
        </script>
    }
    if (TempData["InfoMessage"] != null)
    {
        <script>
            $(document).ready(function() {
                ShowMessage("info message", 'TempData["InfoMessage"]', 'info');
                        });
        </script>
    }
    if (TempData["WarningMessage"] != null)
    {
        <script>
            $(document).ready(function() {
                ShowMessage("Warning message", 'TempData["WarningMessage"]', 'warning');
                        });
        </script>
    }

}