<div class="scrim" id="scrim"></div>
<aside class="glass drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle" aria-hidden="true">
    <div class="d-head">
        <div style="display:flex;align-items:center"><h2 id="drawerTitle">Your cart</h2><span class="count" id="dCount">0 items</span></div>
        <button class="iconbtn" id="closeBtn" type="button" aria-label="Close cart"><span data-icon="x" data-size="18" data-stroke="#0F2547" data-sw="2"></span></button>
    </div>
    <div class="lines" id="dLines"></div>
    <div class="sum" id="dSum">
        <div class="tot"><span>Subtotal</span><b id="dTotal">$0.00</b></div>
        <div class="note">Taxes are calculated at checkout.</div>
        <a class="btn primary big full" id="goCheckout" href="#/checkout"><span data-icon="lock" data-size="18" data-stroke="#FFFBE6" data-sw="2"></span>Go to checkout</a>
        <button class="btn glassy full" id="keepBtn" type="button">Continue shopping</button>
    </div>
</aside>
